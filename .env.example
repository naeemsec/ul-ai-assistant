# Gemini AI (MAIn MODAL)
GEMINI_API_KEY_1=your_gemini_api_key_here
_________and so on 
GEMINI_MODEL=gemini-3.5-flash

GEMINI_RPD_LIMIT=20
GEMINI_RPM_LIMIT=5

# Groq AI (BACKUP MODEL)
GROQ_API_KEY_1=your_groq_api_key_here
_________and so on 
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

GROQ_RPD_LIMIT=1000
GROQ_RPM_LIMIT=30

# PDF Chat AI
PDF_API_KEY=your_gemini_api_key_here (You can use same key for both)

# Server
PORT=3000

# To Receive FEEDBACK on your email
FEEDBACK_EMAIL_USER=your_sender_email_address
FEEDBACK_EMAIL_TO=your_receiver_email_address
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token